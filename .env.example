# CaféFlow BD - Production-ready Multi-tenant SaaS Environment Variables

# Runtime Environment
NODE_ENV=development

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Accessible in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-token
